{
  "name": "@timmygod/pi-web-local",
  "description": "Local-model and LAN-optimized web UI for the pi coding agent",
  "version": "0.0.1-beta.40",
  "keywords": [
    "pi-package",
    "pi-web",
    "local-llm",
    "self-hosted",
    "lan",
    "qwen",
    "ollama",
    "coding-agent",
    "pwa"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/run-lifecycle.mjs install",
    "preuninstall": "node scripts/run-lifecycle.mjs uninstall",
    "test:extensions": "vitest run --config tests/extensions/vitest.config.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmygod/pi-web"
  },
  "license": "MIT",
  "devDependencies": {
    "typebox": "^1.1.38",
    "vitest": "^4.1.7"
  }
}
